pkgname=yaru-theme
pkgver=1.0
pkgrel=1
pkgdesc=""
arch=('any')
license=('custom')

options=('!strip' '!debug')

source=('yaru-theme.zip')
sha256sums=('SKIP')

package() {
    install -dm755 "$pkgdir/usr/share"

    cp -a "$srcdir/gnome-shell/." \
          "$pkgdir/usr/share/gnome-shell"

    cp -a "$srcdir/icons/." \
          "$pkgdir/usr/share/icons"

    cp -a "$srcdir/sounds/." \
          "$pkgdir/usr/share/sounds"

    cp -a "$srcdir/themes/." \
          "$pkgdir/usr/share/themes"
}
