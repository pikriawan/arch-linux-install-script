#!/usr/bin/env bash

if [[ "$1" = "increase" ]]; then
    wpctl set-volume @DEFAULT_AUDIO_SINK@ -l 1 5%+
elif [[ "$1" = "decrease" ]]; then
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
elif [[ "$1" = "mute" ]]; then
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
elif [[ "$1" = "mic-mute" ]]; then
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
fi

volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}')
volume=$(node -e "console.log(parseInt($volume * 100))")
mute=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $3}')

if [[ "$mute" = "[MUTED]" ]]; then
    notify-send -a volume -h string:x-canonical-private-synchronous:volume -h int:value:$volume "Volume: $volume% (muted)"
else
    notify-send -a volume -h string:x-canonical-private-synchronous:volume -h int:value:$volume "Volume: $volume%"
fi

if [[ "$(playerctl status)" != "Playing" ]]; then
    canberra-gtk-play -i audio-volume-change -d "changeVolume"
fi
