#!/usr/bin/env bash

directory_path="$(xdg-user-dir PICTURES)/Screenshots"

if [[ ! -d "$directory_path" ]]; then
    mkdir -p "$directory_path"
fi

file_path="$directory_path/Screenshot From $(date +%Y-%m-%d\ %H-%M-%S).png"

choice=$(echo -e "Selection\nWindow\nScreen" | rofi -dmenu -i -p screenshot_frame_2 -theme-str 'entry { placeholder: "Screenshot"; }')

sleep 0.2

case "$choice" in
    "Selection")
        wayfreeze & PID=$!
        sleep 0.1
        geometry="$(slurp)"
        if [ -n "$geometry" ]; then
            grim -g "$geometry" - | tee "$file_path" | wl-copy
            notify-send -a screenshot "Screenshot saved"
        fi
        kill $PID
        ;;
    "Window")
        active_window="$(hyprctl activewindow -j)"
        if [ "$active_window" != "{}" ]; then
            grim -g "$(echo "$active_window" | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')" - | tee "$file_path" | wl-copy
            notify-send -a screenshot "Screenshot saved"
        fi
        ;;
    "Screen")
        grim - | tee "$file_path" | wl-copy
        notify-send -a screenshot "Screenshot saved"
        ;;
esac
