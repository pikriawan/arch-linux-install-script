configuration {
    modes: [ drun ];
    drun-display-format: "{name}";
    display-drun: "apps";
    icon-theme: "Yaru-olive-dark";

    drun {
        fallback-icon: "application-x-executable";
    }
}

@theme "default"

window {
    width: 400px;
    background-color: #{background};
    border: 2px;
    border-color: #{outline_variant};
    padding: 12px;
}

mainbox {
    spacing: 0;
}

inputbar {
    children: [ prompt, entry ];
    padding: 6px;
    spacing: 12px;
}

prompt {
    font: "Material Symbols Rounded 16";
    text-color: #{foreground};
}

entry {
    vertical-align: 0.5;
    text-color: #{foreground};
    placeholder-color: #{outline_variant};
}

textbox {
    text-color: #{foreground};
}

listview {
    scrollbar: false;
    border: 0;
    padding: 0;
    spacing: 0;
}

element {
    spacing: 12px;
    padding: 6px;
}

element normal.normal {
    background-color: transparent;
    text-color: #{foreground};
}

element normal.urgent {
    background-color: transparent;
    text-color: #{foreground};
}

element normal.active {
    background-color: #{outline};
    text-color: #{foreground};
}

element selected.normal {
    background-color: #{outline_variant};
    text-color: #{foreground};
}

element selected.urgent {
    background-color: #{outline_variant};
    text-color: #{foreground};
}

element selected.active {
    background-color: #{outline_variant};
    text-color: #{foreground};
}

element alternate.normal {
    background-color: transparent;
    text-color: #{foreground};
}

element alternate.urgent {
    background-color: transparent;
    text-color: #{foreground};
}

element alternate.active {
    background-color: #{outline};
    text-color: #{foreground};
}

element-icon {
    size: 24px;
}

element-text {
    highlight: #22da6f;
    vertical-align: 0.5;
}
