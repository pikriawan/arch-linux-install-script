local terminal = "alacritty"
local fileManager = "nautilus"
local menu = "rofi -show drun -show-icons -theme-str 'entry { placeholder: \"Apps\"; }'"
local browser = "firefox"


-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("gsettings set org.gnome.desktop.interface color-scheme {gtk_color_scheme}")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface icon-theme {gtk_icon_theme}")

    hl.exec_cmd("hypridle")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("hyprsunset")
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd("waybar")

    hl.exec_cmd("systemctl --user restart xdg-desktop-portal-hyprland")

    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")
end)


